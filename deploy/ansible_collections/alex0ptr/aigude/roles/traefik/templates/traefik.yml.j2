{{ ansible_managed | comment }}
global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: INFO

entryPoints:
  {{ traefik_web_entrypoint }}:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: {{ traefik_websecure_entrypoint }}
          scheme: https
  {{ traefik_websecure_entrypoint }}:
    address: ":443"

providers:
  file:
    directory: {{ traefik_dynamic_dir }}
    watch: true

certificatesResolvers:
  {{ traefik_cert_resolver }}:
    acme:
      email: {{ traefik_acme_email }}
      # Staging and production keep their certificates in separate files, so a switch never reuses the other's.
      storage: /data/acme{{ '-staging' if traefik_acme_staging else '' }}.json
{% if traefik_acme_staging %}
      caServer: https://acme-staging-v02.api.letsencrypt.org/directory
{% endif %}
      # Port 80 of the host must be reachable from the internet.
      httpChallenge:
        entryPoint: {{ traefik_web_entrypoint }}
