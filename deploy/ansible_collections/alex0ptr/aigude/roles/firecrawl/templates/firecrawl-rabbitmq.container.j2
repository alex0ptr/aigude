{{ ansible_managed | comment }}
[Unit]
Description=Firecrawl: RabbitMQ
{% if firecrawl_target | length > 0 %}
PartOf={{ firecrawl_target }}
After={{ firecrawl_target }}
{% endif %}

[Container]
ContainerName=firecrawl-rabbitmq
Image=firecrawl-rabbitmq.image
Network={{ firecrawl_network }}.network
# User rabbitmq, not root: the health check runs by exec as the user of the container. As root, rabbitmq-diagnostics
# creates a .erlang.cookie (root, 0400) before the server writes its own, and the server (rabbitmq) stops with "eacces".
User=rabbitmq:rabbitmq
Exec=rabbitmq-server
HealthCmd=rabbitmq-diagnostics -q check_running
HealthInterval=5s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=5s
# The unit counts as started once the container is healthy, which is what the units that require it wait for.
Notify=healthy

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=900

[Install]
WantedBy={{ firecrawl_target or 'multi-user.target' }}
